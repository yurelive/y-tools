# Copie para .env e ajuste conforme necessário. Nunca commite o .env.

# Modelo padrão do Whisper: tiny, base, small, medium, large-v3, turbo
YTOOLS_MODELO_WHISPER=small

# true para logs em nível DEBUG
YTOOLS_DEBUG=false

# Canais do seu roteador para o monitor de Wi-Fi (o da rede conectada é detectado sozinho)
YTOOLS_WIFI_MEUS_CANAIS=
